# Copy to .env (git-ignored) and fill in.
ANTHROPIC_API_KEY=

# Gmail over IMAP. Needs 2-Step Verification on, then an app password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional. Leave empty for a dedicated intake address (every email is read).
# Or comma-separated senders to watch, e.g. the site QS address. These also show on the
# email rules screen as read-only allow rules ("from .env").
WATCH_FROM=
MAIL_SINCE_DAYS=30

# Optional. Where the email allow/block rules are saved (default data/email_rules.json).
# EMAIL_RULES_PATH=

# Replies to the site (conflicts, partial or no item code). Sending uses the Gmail account above over
# SMTP and is limited to these test inboxes: comma-separated addresses or @domains. Empty = copy only.
REPLY_ALLOWED_TO=
# Optional. Where case decisions and sent replies are saved (default data/cases).
# CASES_DIR=
