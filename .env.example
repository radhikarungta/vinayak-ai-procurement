# Copy to .env (git-ignored) and fill in.
# OpenAI runs every model call: email intake, item-code picks and the Ask assistant.
# Without a key the app runs the sample in replay mode. OPENAI_MODEL is optional (default gpt-6.2-sol).
OPENAI_API_KEY=
OPENAI_MODEL=

# Gmail over IMAP. Needs 2-Step Verification on, then an app password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional. Leave empty for a dedicated intake address (every email is read).
# Or comma-separated senders to watch, e.g. the site QS address. These also show on the
# email rules screen as read-only allow rules ("from .env").
WATCH_FROM=
MAIL_SINCE_DAYS=30

# Optional. Where the email allow/block rules are saved (default data/email_rules.json).
# EMAIL_RULES_PATH=

# Replies to the site (conflicts, partial or no item code). Sending uses the Gmail account above over
# SMTP and is limited to these test inboxes: comma-separated addresses or @domains. Empty = copy only.
REPLY_ALLOWED_TO=
# The HOD who approves the chosen vendor (step 7). Sending to it follows REPLY_ALLOWED_TO too.
HOD_EMAIL=
# Optional. Where case decisions and sent replies are saved (default data/cases).
# CASES_DIR=

# Supabase (optional): keep each requirement's state in Postgres instead of data/cases/*.json.
# Run supabase/migrations/001_case_state.sql once. Service-role key: server only, never in the page.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin login (no database). Defaults are admin / admin: set your own before the app is public.
ADMIN_USER=
ADMIN_PASSWORD=
# Signs the session cookie; any long random string. AUTH=off turns the login off.
SESSION_SECRET=
